# Секретный токен для доступа в админку (/admin.html). Придумайте длинную случайную строку.
ADMIN_TOKEN=changeme-please-set-a-long-random-token

# Ключ DeepSeek API — нужен только для функции "Распарсить через LLM" в админке.
# Получить можно на https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Опционально: переопределить базовый URL или модель DeepSeek.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
