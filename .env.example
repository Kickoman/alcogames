# Секретный токен для доступа в админку (/admin.html). Придумайте длинную случайную строку.
ADMIN_TOKEN=changeme-please-set-a-long-random-token

# LLM для кнопки "Распарсить через LLM". Всё ниже — только значения по умолчанию:
# провайдер и ключи настраиваются в админке (раздел «Настройки LLM») и хранятся
# в data/llm_settings.json. Можно вообще ничего не задавать здесь.
#
# Провайдер по умолчанию: none | deepseek | yandex.
# Если не задан, но есть DEEPSEEK_API_KEY — используется deepseek.
# LLM_PROVIDER=yandex

# DeepSeek (https://platform.deepseek.com)
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Yandex Cloud (AI Studio). Сервисному аккаунту нужна роль ai.languageModels.user,
# API-ключу — область yc.ai.languageModels.execute. Каталог вида b1g...
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=b1g...
# YANDEX_MODEL=yandexgpt-lite/latest

# Порт, на котором сервис слушает снаружи контейнера.
PORT=8000
